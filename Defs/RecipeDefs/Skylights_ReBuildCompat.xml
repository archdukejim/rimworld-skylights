<?xml version="1.0" encoding="utf-8"?>
<!--
  SOFT-DEPENDENCY COMPAT: "ReBuild: Doors and Corners" (packageId ReBuild.COTR.DoorsAndCorners).

  Both mods represent glass as a fixed costList INGREDIENT (not a stuff), verified from both mods' Defs, so
  the plain glasses can't be substituted in build costs. Instead: free, bidirectional conversion between the
  two plain glasses (StructuralGlass <-> RB_Glass) at a crafting spot — no equipment or research, trivial
  flat work time, in batches of 1 / 5 / 10 / 50 (a x50 batch takes the same time as a x1).

  Each RecipeDef is gated by MayRequire="ReBuild.COTR.DoorsAndCorners" (packageId). When ReBuild is not
  active these defs are discarded during XML loading, before cross-reference resolution, so RB_Glass is never
  referenced and the mod loads with no errors and no crafting-spot clutter. No hard modDependency, no C#.
  (Tinted structural glass is intentionally excluded — it's a UV specialty that needs the tint process, not a
  trivial reshaping.)
-->
<Defs>

  <!-- Shared base: crafting spot, no research, tiny FLAT work (same for every batch size). -->
  <RecipeDef Name="Skylights_GlassConvertBase" Abstract="True">
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <workAmount>60</workAmount>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>

  <!-- ============ ReBuild glass -> structural glass ============ -->
  <RecipeDef ParentName="Skylights_GlassConvertBase" MayRequire="ReBuild.COTR.DoorsAndCorners">
    <defName>Skylights_ToStructural_1x</defName>
    <label>rework glass into structural glass</label>
    <description>Rework glass into structural glass at a crafting spot.</description>
    <jobString>Reworking glass into structural glass.</jobString>
    <ingredients><li><filter><thingDefs><li>RB_Glass</li></thingDefs></filter><count>1</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>RB_Glass</li></thingDefs></fixedIngredientFilter>
    <products><StructuralGlass>1</StructuralGlass></products>
  </RecipeDef>

  <RecipeDef ParentName="Skylights_GlassConvertBase" MayRequire="ReBuild.COTR.DoorsAndCorners">
    <defName>Skylights_ToStructural_5x</defName>
    <label>rework glass into structural glass x5</label>
    <description>Rework five glass into five structural glass at a crafting spot.</description>
    <jobString>Reworking glass into structural glass.</jobString>
    <ingredients><li><filter><thingDefs><li>RB_Glass</li></thingDefs></filter><count>5</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>RB_Glass</li></thingDefs></fixedIngredientFilter>
    <products><StructuralGlass>5</StructuralGlass></products>
  </RecipeDef>

  <RecipeDef ParentName="Skylights_GlassConvertBase" MayRequire="ReBuild.COTR.DoorsAndCorners">
    <defName>Skylights_ToStructural_10x</defName>
    <label>rework glass into structural glass x10</label>
    <description>Rework ten glass into ten structural glass at a crafting spot.</description>
    <jobString>Reworking glass into structural glass.</jobString>
    <ingredients><li><filter><thingDefs><li>RB_Glass</li></thingDefs></filter><count>10</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>RB_Glass</li></thingDefs></fixedIngredientFilter>
    <products><StructuralGlass>10</StructuralGlass></products>
  </RecipeDef>

  <RecipeDef ParentName="Skylights_GlassConvertBase" MayRequire="ReBuild.COTR.DoorsAndCorners">
    <defName>Skylights_ToStructural_50x</defName>
    <label>rework glass into structural glass x50</label>
    <description>Rework fifty glass into fifty structural glass at a crafting spot.</description>
    <jobString>Reworking glass into structural glass.</jobString>
    <ingredients><li><filter><thingDefs><li>RB_Glass</li></thingDefs></filter><count>50</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>RB_Glass</li></thingDefs></fixedIngredientFilter>
    <products><StructuralGlass>50</StructuralGlass></products>
  </RecipeDef>

  <!-- ============ structural glass -> ReBuild glass ============ -->
  <RecipeDef ParentName="Skylights_GlassConvertBase" MayRequire="ReBuild.COTR.DoorsAndCorners">
    <defName>Skylights_ToRBGlass_1x</defName>
    <label>rework structural glass into glass</label>
    <description>Rework structural glass into glass at a crafting spot.</description>
    <jobString>Reworking structural glass into glass.</jobString>
    <ingredients><li><filter><thingDefs><li>StructuralGlass</li></thingDefs></filter><count>1</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>StructuralGlass</li></thingDefs></fixedIngredientFilter>
    <products><RB_Glass>1</RB_Glass></products>
  </RecipeDef>

  <RecipeDef ParentName="Skylights_GlassConvertBase" MayRequire="ReBuild.COTR.DoorsAndCorners">
    <defName>Skylights_ToRBGlass_5x</defName>
