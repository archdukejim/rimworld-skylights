  <!-- Skylight dome: 2 steel -> 1 prefab dome unit. -->
  <RecipeDef ParentName="SkylightSmelterRecipeBase">
    <defName>Make_SkylightDome</defName>
    <label>make skylight dome</label>
    <description>Cast a prefabricated skylight dome from two units of steel — faster than hand-building one at a crafting spot.</description>
    <jobString>Making skylight dome.</jobString>
    <workAmount>1000</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
