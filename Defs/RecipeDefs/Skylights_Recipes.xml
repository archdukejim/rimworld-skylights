<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef Name="SkylightSmelterRecipeBase" Abstract="True">
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>ElectricSmelter</li>
    </recipeUsers>
    <researchPrerequisite>Electricity</researchPrerequisite>
  </RecipeDef>

  <!-- Pre-industrial route: hand-worked at a crafting spot, no smelter. -->
  <RecipeDef Name="SkylightCraftSpotRecipeBase" Abstract="True">
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>

  <!-- Basic pane: 1 steel -> 1 crude pane, hand-worked. Needs Complex Furniture (matches the basic skylight). -->
  <RecipeDef ParentName="SkylightCraftSpotRecipeBase">
    <defName>Make_BasicPane</defName>
    <label>make basic pane x1</label>
    <description>Hand-work one rough glass pane from one unit of steel.</description>
    <jobString>Making basic pane.</jobString>
    <workAmount>210</workAmount>
    <researchPrerequisite>ComplexFurniture</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <BasicPane>1</BasicPane>
    </products>
  </RecipeDef>

  <!-- Basic pane, bulk: 10 steel -> 10 panes, with a time discount. -->
  <RecipeDef ParentName="SkylightCraftSpotRecipeBase">
    <defName>Make_BasicPane_Bulk</defName>
    <label>make basic pane x10</label>
    <description>Hand-work ten rough glass panes from ten units of steel.</description>
    <jobString>Making basic panes in bulk.</jobString>
    <workAmount>1875</workAmount>
    <researchPrerequisite>ComplexFurniture</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <BasicPane>10</BasicPane>
    </products>
  </RecipeDef>

  <!-- Skylight dome, hand route: 2 steel -> 1 dome at a crafting spot. No research — pre-industrial. -->
  <RecipeDef ParentName="SkylightCraftSpotRecipeBase">
    <defName>Make_SkylightDome_Hand</defName>
    <label>make skylight dome (by hand)</label>
    <description>Hand-build a skylight dome from two units of steel, without a smelter. Slower than casting one at an electric smelter.</description>
    <jobString>Building skylight dome by hand.</jobString>
    <workAmount>1800</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <SkylightDome>1</SkylightDome>
    </products>
  </RecipeDef>

