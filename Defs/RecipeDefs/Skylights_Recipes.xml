  <!-- ATRIUM KITS: one smelter bill per atrium — takes all the steel at once and produces the exact
       glass panes + structural frames that atrium's costList needs, priced at the bulk-recipe rates
       (glass 187.5 work/pane, tinted 230, frames 46.875). Steel = panes + ceil(frames/4); the dome
       4x4's half-batch of frames costs a full steel (offcuts). Purely a convenience — same materials
       as billing the components separately, one work order instead of two. -->

  <RecipeDef Name="AtriumKitBase" ParentName="SkylightSmelterRecipeBase" Abstract="True">
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
  </RecipeDef>

  <RecipeDef ParentName="AtriumKitBase">
    <defName>Make_AtriumKit_Domed_22</defName>
    <label>smelt domed atrium kit (2x2)</label>
    <description>Smelt everything a domed atrium skylight (2x2) needs in one order: 6 structural glass panes and 12 structural frames, from 9 units of steel. Same materials as billing the parts separately — just one bill.</description>
    <jobString>Smelting domed atrium kit.</jobString>
    <workAmount>1700</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>9</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <StructuralGlass>6</StructuralGlass>
      <StructuralFrame>12</StructuralFrame>
    </products>
  </RecipeDef>

