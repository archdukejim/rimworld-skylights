<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef Name="SkylightSmelterRecipeBase" Abstract="True">
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>ElectricSmelter</li>
    </recipeUsers>
    <researchPrerequisite>Electricity</researchPrerequisite>
  </RecipeDef>

  <!-- Structural frames: 1 steel -> 4 frames. -->
  <RecipeDef ParentName="SkylightSmelterRecipeBase">
    <defName>Make_StructuralFrame</defName>
    <label>make structural frames x4</label>
    <description>Fabricate four structural frames from one unit of steel.</description>
    <jobString>Making structural frames.</jobString>
    <workAmount>210</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <StructuralFrame>4</StructuralFrame>
    </products>
  </RecipeDef>

  <!-- Structural frames, bulk: 10 steel -> 40 frames, with a time discount. -->
  <RecipeDef ParentName="SkylightSmelterRecipeBase">
    <defName>Make_StructuralFrame_Bulk</defName>
    <label>make structural frames x40</label>
    <description>Fabricate forty structural frames from ten units of steel.</description>
    <jobString>Making structural frames in bulk.</jobString>
    <workAmount>1875</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <StructuralFrame>40</StructuralFrame>
    </products>
  </RecipeDef>

