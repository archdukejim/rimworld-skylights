    <defName>Make_BasicPane</defName>
    <label>make basic pane x1</label>
    <description>Hand-work one rough glass pane from one unit of steel.</description>
    <jobString>Making basic pane.</jobString>
    <workAmount>210</workAmount>
    <researchPrerequisite>ComplexFurniture</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <BasicPane>1</BasicPane>
    </products>
  </RecipeDef>

