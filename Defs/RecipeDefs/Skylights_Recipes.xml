  <!-- Tinted glass: 1 steel -> 1 UV-filtering pane. Needs Complex Furniture (a step past structural glass). -->
  <RecipeDef ParentName="SkylightSmelterRecipeBase">
    <defName>Make_TintedGlass</defName>
    <label>make tinted structural glass x1</label>
