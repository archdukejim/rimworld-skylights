  <!-- Reflection tube: 5 steel -> 1 mirror-lined tube, needed for mountain-piercing skylights. -->
  <RecipeDef ParentName="SkylightSmelterRecipeBase">
    <defName>Make_ReflectionTube</defName>
    <label>make reflection tube</label>
    <description>Fabricate a mirror-lined reflection tube from five units of steel.</description>
