<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Shared base for both skylight buildings: walkable, powerless, sun-tracking. -->
  <ThingDef Name="SkylightBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <!-- Rare-tick so CompSkylight.CompTickRare runs: the dome glow tracks day/night, the paned cell's
         sky/sun registration follows roof changes, and the weak-glass skylight collapses when unsupported. -->
    <tickerType>Rare</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- Transparent (not the default Cutout): the material colour's alpha then scales the sprite, which
           is what the global opacity slider (Skylights.SkylightOpacity) adjusts at runtime. -->
      <shaderType>Transparent</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <!-- A skylight sits up in the roof, so it draws over pretty much everything below it (plants, items, pawns). -->
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <castEdgeShadows>false</castEdgeShadows>
    <rotatable>false</rotatable>
    <!-- Roof-mounted: not directly clickable (clicks pass through to whatever is below);
         remove it with the Architect > Orders > Deconstruct area tool. -->
    <selectable>false</selectable>
    <canOverlapZones>true</canOverlapZones>
    <clearBuildingArea>false</clearBuildingArea>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Skylights</designationCategory>
    <!-- Research is set per skylight. All skylights need Complex Furniture (glazing/carpentry); the
         smelter-built ones (industrial, tinted, light tunnel) also need Electricity. -->
    <constructEffect>ConstructMetal</constructEffect>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>

  <!-- Dome: small opening, spreads soft daylight over a radius, never bright enough to grow crops.
       Available at Smithing — the dome prefab can be hand-built at a crafting spot (a smelter just makes it cheaper). -->
  <ThingDef ParentName="SkylightBase">
    <defName>Skylight_Dome</defName>
    <label>dome skylight</label>
    <description>A dome-style opening that spreads soft natural light across a small area. It is a prefabricated unit that simply drops into a roof, so it installs almost instantly. It brightens a room by real daylight — bright at midday, dark at night — but its light never concentrates enough to grow crops. The dome can be hand-built at a crafting spot or cast faster at an electric smelter. It won't work under thick overhead mountain, which blocks the open sky.</description>
    <graphicData>
      <texPath>Things/Building/Skylight_Dome</texPath>
    </graphicData>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>180</WorkToBuild>
      <Mass>2</Mass>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <SkylightDome>1</SkylightDome>
    </costList>
    <!-- Ring matches the actual glowRadius below, so the placement preview shows the true lit reach. -->
    <specialDisplayRadius>2.6</specialDisplayRadius>
    <comps>
      <li Class="CompProperties_Glower">
        <!-- Low magnitude, non-overlit: caps at 0.5 ground glow so it can never grow crops, and
             (scaled by glowFactor below) it tracks the sky proportionally — dimmer at dusk, dark at
             night, never brighter than the daylight it channels. -->
        <overlightRadius>0</overlightRadius>
        <glowRadius>2.6</glowRadius>
        <glowColor>(120, 118, 106, 0)</glowColor>
      </li>
      <li Class="Skylights.CompProperties_Skylight">
        <glowFactor>0.5</glowFactor>
        <!-- Display-only: render the lit pool at full open-sky brightness (matching outdoors, tracking the sky)
             out to the mod-menu dome radius. Gameplay light stays at the half-strength glower above. -->
        <matchOutdoorGlow>true</matchOutdoorGlow>
      </li>
    </comps>
  </ThingDef>

  <!-- Hidden glow emitter for the multi-cell dome variants. The parent dome spawns one of these on each of
       its footprint cells and drives them together (see CompSkylight.glowNodeDef), so the pooled light is
       centred on the footprint instead of leaning to the root corner. Not buildable, not drawn, not saved. -->
  <ThingDef>
    <defName>Skylight_DomeGlowNode</defName>
    <label>skylight glow</label>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <isSaveable>false</isSaveable>
    <selectable>false</selectable>
    <drawerType>None</drawerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <useHitPoints>false</useHitPoints>
    <tickerType>Never</tickerType>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Skylight_Dome</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <claimable>false</claimable>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <overlightRadius>0</overlightRadius>
        <glowRadius>2.6</glowRadius>
        <glowColor>(120, 118, 106, 0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <!-- Dome variants: the same soft-light dome, but on a 2x1 or 2x2 footprint. An even-sized room has no
       centre tile for a 1x1 dome to sit on, so these let the dome be placed dead-centre in a room whose
       width and/or depth is even. Their light is pooled from hidden nodes so it stays centred. -->
  <ThingDef ParentName="SkylightBase">
    <defName>Skylight_Dome_Wide</defName>
    <label>dome skylight (2x1)</label>
    <description>A dome skylight on a two-by-one footprint, so it can be centred along an even-width (or even-depth) room. It spreads the same soft natural daylight as the standard dome — bright at midday, dark at night, never enough to grow crops — and installs just as quickly. It won't work under thick overhead mountain.</description>
    <size>(1,2)</size>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/Skylight_Dome</texPath>
      <!-- Normal 1x1 dome sprite, drawn centred on the 2x1 footprint (the footprint is only for light centring). -->
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Mass>2</Mass>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <SkylightDome>1</SkylightDome>
    </costList>
    <!-- No specialDisplayRadius: vanilla centres that ring on the root cell, which reads off-centre on an
         even footprint. PlaceWorker_ShowFootprint draws the true (footprint-centred) lit area instead. -->
    <!-- The installed sprite is a 1x1 dome centred on the footprint, so while placing, the footprint is
         invisible without help: outline the occupied tiles and bracket their corners. -->
    <placeWorkers>
      <li>Skylights.PlaceWorker_ShowFootprint</li>
    </placeWorkers>
    <comps>
      <li Class="Skylights.CompProperties_Skylight">
        <glowFactor>0.5</glowFactor>
        <!-- Centred pooled light: one hidden glower per footprint cell (each at the dome's own radius) instead
             of a corner-mounted one. Half-strength per node; overlapping they pool to a dome-bright, dome-reach
             pool centred on the footprint. Ground glow still caps at 0.5 (no crops). -->
        <glowNodeDef>Skylight_DomeGlowNode</glowNodeDef>
        <glowNodeStrength>0.5</glowNodeStrength>
        <!-- Display-only: render the pooled lit area at full open-sky brightness (matching outdoors) out to the
             mod-menu dome radius. Gameplay light stays at the half-strength pooled nodes above. -->
        <matchOutdoorGlow>true</matchOutdoorGlow>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="SkylightBase">
    <defName>Skylight_Dome_Quad</defName>
    <label>dome skylight (2x2)</label>
    <description>A dome skylight on a two-by-two footprint, so it can be centred in a room whose width and depth are both even. It spreads the same soft natural daylight as the standard dome — bright at midday, dark at night, never enough to grow crops — and installs just as quickly. It won't work under thick overhead mountain.</description>
    <size>(2,2)</size>
    <graphicData>
      <texPath>Things/Building/Skylight_Dome</texPath>
      <!-- Normal 1x1 dome sprite, drawn centred on the 2x2 footprint (the footprint is only for light centring). -->
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>220</WorkToBuild>
      <Mass>2</Mass>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <SkylightDome>1</SkylightDome>
    </costList>
    <!-- No specialDisplayRadius: vanilla centres that ring on the root cell, which reads off-centre on an
         even footprint. PlaceWorker_ShowFootprint draws the true (footprint-centred) lit area instead. -->
    <!-- The installed sprite is a 1x1 dome centred on the footprint, so while placing, the footprint is
         invisible without help: outline the occupied tiles and bracket their corners. -->
    <placeWorkers>
      <li>Skylights.PlaceWorker_ShowFootprint</li>
    </placeWorkers>
    <comps>
      <li Class="Skylights.CompProperties_Skylight">
        <glowFactor>0.5</glowFactor>
        <!-- Centred pooled light: one hidden glower per footprint cell (each at the dome's own radius) instead
             of a corner-mounted one. Half-strength per node; overlapping they pool to a dome-bright, dome-reach
             pool centred on the footprint. Ground glow still caps at 0.5 (no crops). -->
        <glowNodeDef>Skylight_DomeGlowNode</glowNodeDef>
        <glowNodeStrength>0.5</glowNodeStrength>
        <!-- Display-only: render the pooled lit area at full open-sky brightness (matching outdoors) out to the
             mod-menu dome radius. Gameplay light stays at the half-strength pooled nodes above. -->
        <matchOutdoorGlow>true</matchOutdoorGlow>
      </li>
    </comps>
  </ThingDef>

  <!-- Industrial: single cast-glass square that passes the full sky onto its own tile (growable).
       (defName kept as Skylight_Paned for save compatibility with v1.) -->
  <ThingDef ParentName="SkylightBase">
    <defName>Skylight_Paned</defName>
    <label>industrial skylight</label>
    <description>A single reinforced structural-glass pane in a smelted frame that glazes one square of roof. It lets the full strength of the sky pass straight down onto the tile below — bright enough to grow crops by daylight, and dark at night. It passes true sunlight too: a pawn standing beneath it counts as being in the sun, so sun-loving genes gain their benefit indoors and sun-sensitive ones are exposed (glaze with tinted structural glass instead to filter that out). Built from four structural frames and one structural glass pane. It won't work under thick overhead mountain, which blocks the open sky.</description>
    <graphicData>
      <texPath>Things/Building/Skylight_Paned</texPath>
    </graphicData>
    <researchPrerequisites>
      <li>Electricity</li>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>90</WorkToBuild>
      <Mass>3</Mass>
      <Beauty>3</Beauty>
    </statBases>
    <costList>
      <!-- Four frame pieces (one per side of the window) plus a glass pane. -->
      <StructuralFrame>4</StructuralFrame>
      <StructuralGlass>1</StructuralGlass>
    </costList>
    <specialDisplayRadius>2</specialDisplayRadius>
    <!-- Drag out a filled grid when building, exactly like placing floors. -->
    <drawStyleCategory>Floors</drawStyleCategory>
    <comps>
      <li Class="Skylights.CompProperties_Skylight">
        <!-- Renders and lights the tile as if there were no roof: full sky light, sky colour,
             moonlight and shadows. Grows crops by day, dark at night, never brighter than outside. -->
        <renderAsSky>true</renderAsSky>
        <!-- Clear glass: the cell counts as real sunlight for Biotech genes/stats/thoughts, so sun-loving
             xenotypes gain their outdoor benefit indoors and sun-sensitive pawns are exposed. -->
        <transmitsSun>true</transmitsSun>
        <!-- Display-only: a 1-tile ring around the pane also renders as open sky, so the lit patch reads a
             little wider than the single tile. Cosmetic only — the ring doesn't grow crops or transmit sun. -->
        <glowHaloRadius>1</glowHaloRadius>
      </li>
    </comps>
  </ThingDef>

  <!-- Tinted: identical to the industrial skylight once installed, but UV-filtered — lights and grows
       exactly the same, yet the tile registers no sun for Biotech genes (transmitsSun left false). -->
  <ThingDef ParentName="SkylightBase">
    <defName>Skylight_Tinted</defName>
    <label>tinted skylight</label>
    <description>A single reinforced tinted structural-glass pane in a frame that glazes one square of roof. Like the industrial skylight it lets full daylight pass onto the tile below — bright enough to grow crops, dark at night — but its UV-filtering tint keeps sun-reactive genes from triggering, so sun-sensitive colonists can stand beneath it unharmed (and sun-loving ones gain nothing). Built from four structural frames and one tinted structural glass pane. It won't work under thick overhead mountain, which blocks the open sky.</description>
    <graphicData>
      <!-- Identical installed appearance to the clear pane. -->
      <texPath>Things/Building/Skylight_Paned</texPath>
    </graphicData>
    <!-- Electricity for the smelter chain, plus Complex Furniture for the tinting process. -->
    <researchPrerequisites>
      <li>Electricity</li>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>90</WorkToBuild>
      <Mass>3</Mass>
      <Beauty>3</Beauty>
    </statBases>
    <costList>
      <StructuralFrame>4</StructuralFrame>
      <TintedGlass>1</TintedGlass>
    </costList>
    <specialDisplayRadius>2</specialDisplayRadius>
    <drawStyleCategory>Floors</drawStyleCategory>
    <comps>
      <li Class="Skylights.CompProperties_Skylight">
        <!-- Renders/lights as open sky (crops, moonlight, shadows), but transmitsSun stays false:
             the tint filters the sun out for genes. -->
        <renderAsSky>true</renderAsSky>
        <!-- Display-only 1-tile ring rendered as open sky, so the lit patch reads a little wider than the
             single tile. Cosmetic only — the ring doesn't grow crops. -->
        <glowHaloRadius>1</glowHaloRadius>
      </li>
    </comps>
  </ThingDef>

  <!-- Light tunnel: same soft daylight as the dome, but a reflection tube pierces thick overhead mountain.
       (defName kept as Skylight_MountainDome for save compatibility with v1.) -->
  <ThingDef ParentName="SkylightBase">
    <defName>Skylight_MountainDome</defName>
    <label>light tunnel</label>
    <description>A skylight dome fitted to a reflection tube that channels daylight down through solid overhead rock. It spreads the same soft natural light as a dome skylight — bright at midday, dark at night — but unlike a plain dome it keeps working beneath thick overhead mountain. Installed from a prefabricated skylight dome and a mirror-lined reflection tube, so fitting it takes real work.</description>
    <graphicData>
      <texPath>Things/Building/Skylight_Dome</texPath>
    </graphicData>
    <researchPrerequisites>
      <li>Electricity</li>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Mass>2</Mass>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <SkylightDome>1</SkylightDome>
      <ReflectionTube>1</ReflectionTube>
    </costList>
    <!-- Ring matches the actual glowRadius below, so the placement preview shows the true lit reach. -->
    <specialDisplayRadius>2.6</specialDisplayRadius>
    <comps>
      <li Class="CompProperties_Glower">
        <!-- Same soft, sky-proportional light as the dome (never grows crops). -->
        <overlightRadius>0</overlightRadius>
        <glowRadius>2.6</glowRadius>
        <glowColor>(120, 118, 106, 0)</glowColor>
      </li>
      <li Class="Skylights.CompProperties_Skylight">
        <worksUnderThickRoof>true</worksUnderThickRoof>
        <glowFactor>0.5</glowFactor>
        <!-- Display-only: render the lit pool at full open-sky brightness out to the mod-menu dome radius, even
             under thick mountain. Gameplay light stays at the half-strength glower above. -->
        <matchOutdoorGlow>true</matchOutdoorGlow>
      </li>
    </comps>
  </ThingDef>

  <!-- Basic skylight: the pre-industrial pane. Full sky on its tile (crops + true sun for genes) like the
       industrial one, but crude and weak — built from wood and a hand-worked basic pane, no smelter. It only
       holds if a wall/pillar is within 3 tiles; lose that support and the roof caves in, destroying the
       materials. (Was Skylight_Tribal in earlier v2 dev; renamed before release.) -->
  <ThingDef ParentName="SkylightBase">
    <defName>Skylight_Basic</defName>
    <label>basic skylight</label>
    <description>A crude glazed pane in a light timber frame, knocked together on the spot without a smelter or power. It opens one square of roof to the full sky — bright enough to grow crops by daylight, dark at night — and passes true sunlight, so Biotech sun-genes register it (sun-lovers gain their benefit indoors, sun-sensitive pawns are exposed). The frame is weak: it only holds if a wall or pillar sits within three tiles to carry the roof. Remove that support and the roof caves in, shattering the pane. It won't work under thick overhead mountain, which blocks the open sky.</description>
    <graphicData>
      <texPath>Things/Building/Skylight_Paned</texPath>
    </graphicData>
    <!-- Complex Furniture (glazing/carpentry), but no Electricity: the crude pane is hand-worked, so this is
         the pre-electric true-sky skylight. Complex Furniture has no prerequisites, so tribal starts can reach it. -->
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <!-- Weak glass: when it collapses (support lost, fire, raid) the materials are destroyed, not salvaged.
         Normal deconstruction still refunds. -->
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <WorkToBuild>350</WorkToBuild>
      <Mass>3</Mass>
      <Beauty>2</Beauty>
    </statBases>
    <!-- Built on-site: raw wood plus one hand-worked basic pane. No fabricated smelter components. -->
    <costList>
      <WoodLog>4</WoodLog>
      <BasicPane>1</BasicPane>
    </costList>
    <!-- Drag out a filled grid when building, exactly like placing floors. -->
    <drawStyleCategory>Floors</drawStyleCategory>
    <placeWorkers>
      <li>Skylights.PlaceWorker_NearRoofSupport</li>
    </placeWorkers>
    <comps>
      <li Class="Skylights.CompProperties_Skylight">
        <!-- Same true-sky lighting as the industrial pane (crops, moonlight, shadows, gene sun),
             but with the weak-glass support rule. -->
        <renderAsSky>true</renderAsSky>
        <transmitsSun>true</transmitsSun>
        <requiresNearbySupport>true</requiresNearbySupport>
        <supportRadius>3</supportRadius>
        <!-- Display-only 1-tile ring rendered as open sky, so the lit patch reads a little wider than the
             single tile. Cosmetic only — the ring doesn't grow crops or transmit sun. -->
        <glowHaloRadius>1</glowHaloRadius>
      </li>
    </comps>
  </ThingDef>

</Defs>
