<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>StructuralFrame</defName>
    <label>structural frame</label>
    <description>A prefabricated metal frame used to mount panels and fixtures such as skylights. Fabricated in batches at an electric smelter.</description>
    <graphicData>
      <!-- Folder of stack-count textures: _a single L-beam, _b two side by side. -->
      <texPath>Things/Item/Resource/StructuralFrame</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.85, 0.85)</drawSize>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>2.5</MarketValue>
      <Mass>0.4</Mass>
      <Flammability>0.2</Flammability>
      <!-- Metal frame: does not rot outdoors. -->
      <DeteriorationRate>0</DeteriorationRate>
      <MaxHitPoints>60</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>StructuralGlass</defName>
    <label>structural glass</label>
    <description>A reinforced, toughened transparent pane, cast at an electric smelter. Used to glaze skylights and other fixtures.</description>
    <graphicData>
      <!-- Folder of stack-count textures: _a single pane, _b/_c stacked glass. -->
      <texPath>Things/Item/Resource/StructuralGlass</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.85, 0.85)</drawSize>
    </graphicData>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>3.0</MarketValue>
      <Mass>0.5</Mass>
      <Flammability>0</Flammability>
      <!-- Glass: does not rot outdoors. -->
      <DeteriorationRate>0</DeteriorationRate>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <!-- Tribal glazing: a crude pane knocked out at a crafting spot, no smelter. Glazes the basic skylight. -->
  <ThingDef ParentName="ResourceBase">
    <defName>BasicPane</defName>
    <label>basic pane</label>
    <description>A rough, hand-worked glass pane set in a light frame, knocked together at a crafting spot without a smelter. Not as clear or as strong as a cast structural pane, but enough to glaze a simple skylight and let daylight through.</description>
    <graphicData>
      <!-- Crude greenish glass, its own stack-count folder (_a/_b/_c). -->
      <texPath>Things/Item/Resource/BasicPane</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.85, 0.85)</drawSize>
    </graphicData>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>2.0</MarketValue>
      <Mass>0.5</Mass>
      <Flammability>0.2</Flammability>
      <!-- Glass: does not rot outdoors. -->
      <DeteriorationRate>0</DeteriorationRate>
      <MaxHitPoints>40</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>TintedGlass</defName>
    <label>tinted structural glass</label>
    <description>A reinforced glass pane treated with a UV-filtering tint, cast at an electric smelter. It passes visible daylight but blocks the sun's harsher rays — so a skylight glazed with it lights and warms a room exactly like clear glass, yet a body beneath it is shaded from true sun. Requires more advanced fabrication than a plain structural pane.</description>
    <graphicData>
      <!-- Cool smoked-blue tinted glass, its own stack-count folder (_a/_b/_c). -->
      <texPath>Things/Item/Resource/TintedGlass</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.85, 0.85)</drawSize>
    </graphicData>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>4.5</MarketValue>
      <Mass>0.5</Mass>
      <Flammability>0</Flammability>
      <!-- Glass: does not rot outdoors. -->
      <DeteriorationRate>0</DeteriorationRate>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>SkylightDome</defName>
    <label>skylight dome</label>
    <description>A prefabricated dome-shaped skylight unit, cast at an electric smelter and ready to set into a roof. Install one to channel real daylight into a room below.</description>
    <graphicData>
      <texPath>Things/Item/Resource/SkylightDome</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.85, 0.85)</drawSize>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>18</MarketValue>
      <Mass>2</Mass>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <MaxHitPoints>60</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>ReflectionTube</defName>
    <label>reflection tube</label>
    <description>A polished, mirror-lined tube that pipes daylight down through solid rock. Fitted behind a skylight dome, it lets the dome keep working even beneath thick overhead mountain. Fabricated at an electric smelter.</description>
    <graphicData>
      <texPath>Things/Item/Resource/ReflectionTube</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.85, 0.85)</drawSize>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>32</MarketValue>
      <Mass>3</Mass>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <MaxHitPoints>60</MaxHitPoints>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

</Defs>
